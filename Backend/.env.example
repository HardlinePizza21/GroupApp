# Copia este archivo a .env y ajusta si hace falta:
#   cp .env.example .env
#
# Docker Compose usa por defecto .env.example (no subas .env con secretos reales).

PORT=3000

# Postgres del servicio `db` en docker-compose.yml
DATABASE_URL=postgresql://groupapp:groupapp@db:5432/groupapp

JWT_SECRET=dev-jwt-secret-minimo-32-caracteres-cambiar
JWT_REFRESH_SECRET=dev-refresh-secret-minimo-32-caracteres-cambiar

AWS_REGION=us-east-1
# Para subir archivos a S3 hace falta bucket real y credenciales AWS (IAM o variables estándar).
AWS_BUCKET_NAME=dev-bucket-placeholder
